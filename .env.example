# Copy to .env and fill in. Value of the PHPSESSID cookie from a logged-in pixiv.net session.
PIXIV_PHPSESSID=

# Telegram chat export (see TELEGRAM.md). Needed for the first login only; the session is then
# kept in telegram_session/ (never commit it).
TELEGRAM_PHONE=
# Only when the account has two-step verification:
TELEGRAM_PASSWORD=
# Optional: the login code (otherwise it is asked on the terminal), your own app from
# my.telegram.org (otherwise the Telegram Desktop app is used), a proxy, and where the session is kept.
TELEGRAM_CODE=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PROXY=
TELEGRAM_SESSION_DIR=
